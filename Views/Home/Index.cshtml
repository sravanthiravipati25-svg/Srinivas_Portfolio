@model Portfolio.Models.HomeViewModel
@{
    var content = Model.Content;
    var person = content.Person;
    ViewData["Title"] = content.Site.Title;
    ViewData["Description"] = content.Site.Description;
    ViewData["ThemeColor"] = content.Site.ThemeColor;
    var whatsappUrl = "https://wa.me/" + person.PhoneE164 + "?text=" + Uri.EscapeDataString(person.WhatsappMessage);
    var telUrl = "tel:" + person.PhoneE164;
}

<section id="home" class="hero-section">

    <div class="hero-grid"></div>

    <div class="container position-relative">

        <div class="row align-items-center hero-content">

            <!-- LEFT -->
            <div class="col-lg-7 reveal">

                <div class="eyebrow">
                    <span class="status-dot"></span>
                    OPEN TO SQL SERVER / DATA ENGINEERING OPPORTUNITIES
                </div>

                <div class="terminal-label">
                    SQL_SERVER_DEVELOPER.exe
                </div>

                <h1>
                    S Srinivas <span>Rao</span>
                </h1>

                <p class="hero-role">
                    SQL Server Developer
                    <span>|</span>
                    Data Integration
                    <span>|</span>
                    Azure Data Services
                </p>

                <p class="hero-summary">
                    I build reliable, high-performance data systems
                    that turn complex business data into actionable insights.
                </p>

                <div class="tech-line">
                    SQL Server · T-SQL · SSIS · SSRS · Power BI ·
                    Azure SQL · Azure Data Factory
                </div>

                <div class="hero-actions">

                    <a href="mailto:@person.Email"
                       class="btn btn-primary-custom btn-lg"
                       aria-label="Email S Srinivas Rao">
                        <i class="bi bi-envelope-fill"></i>
                        Email Me
                    </a>

                    <a href="@telUrl"
                       class="btn btn-call btn-lg"
                       aria-label="Call S Srinivas Rao">
                        <i class="bi bi-telephone-fill"></i>
                        Call Me
                    </a>

                    <a href="@whatsappUrl"
                       target="_blank"
                       rel="noopener"
                       class="btn btn-whatsapp btn-lg">
                        <i class="bi bi-whatsapp"></i>
                        WhatsApp
                    </a>

                </div>
@* 
                <a href="@person.ResumeUrl"
                   target="_blank"
                   rel="noopener"
                   class="resume-link">
                    <i class="bi bi-file-earmark-pdf"></i>
                    View Resume
                    <i class="bi bi-arrow-up-right"></i>
                </a> *@

            </div>


            <!-- RIGHT -->
            <div class="col-lg-5 reveal">

                <div class="hero-visual">

                    <div class="profile-photo-card">

                        <img src="~/images/Srinivas Profile.jpeg"
                             alt="S Srinivas Rao - SQL Server Developer"
                             class="profile-photo"
                             loading="eager" />

                       @*  <div class="profile-available">
                            <span class="status-dot"></span>
                            Available for opportunities
                        </div> *@

                        <div class="profile-tech">
                            SQL · AZURE · DATA
                        </div>

                    </div>


                    <div class="floating-terminal">

                        <div class="terminal-top">

                            <div class="terminal-controls">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>

                            <span class="terminal-title">
                                profile.sql
                            </span>

                        </div>

                        <div class="terminal-body">

<pre><span class="sql-key">SELECT</span>
    Developer,
    Experience,
    PrimaryStack
<span class="sql-key">FROM</span> CareerProfile
<span class="sql-key">WHERE</span>
    Availability = <span class="sql-name">'Open'</span>;</pre>

                            <div class="query-result">
                                <span>
                                    ✓ Query executed successfully
                                </span>

                                <strong>
                                    3+ Years Experience
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- TECH PROOF BAR -->
        <div class="hero-proof-bar reveal">

            <div>
                <strong>3+</strong>
                <span>Years Experience</span>
            </div>

            <div>
                <strong>SQL</strong>
                <span>Server Development</span>
            </div>

            <div>
                <strong>Azure</strong>
                <span>Data Services</span>
            </div>

            <div>
                <strong>BI</strong>
                <span>Reporting & Analytics</span>
            </div>

        </div>

    </div>

</section>

<section id="about" class="section section-light">
    <div class="container">
        <div class="section-heading reveal">
            <span class="section-kicker">@content.About.Kicker</span>
            <h2>@Html.Raw(content.About.Heading)</h2>
        </div>
        <div class="row g-4">
            <div class="col-lg-7 reveal">
                <div class="content-card about-card">
                    <p class="lead-text">@content.About.LeadText</p>
                    <div class="focus-list">
                        @foreach (var area in content.About.FocusAreas)
                        {
                            <div>
                                <i class="bi @area.Icon"></i>
                                <span><b>@area.Title</b><small>@area.Description</small></span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5 reveal">
                <div class="content-card highlight-card">
                    <span class="mini-label">@content.About.Highlight.Label</span>
                    <h3>@content.About.Highlight.Heading</h3>
                    <p>@content.About.Highlight.Description</p>
                    <div class="mini-metrics">
                        @foreach (var metric in content.About.Highlight.Metrics)
                        {
                            <div><strong>@metric.Label</strong><span>@metric.Value</span></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="experience" class="section section-navy">
    <div class="container">

        <div class="section-heading light reveal">
            <span class="section-kicker">@content.Experience.Kicker</span>
            <h2>@content.Experience.Heading</h2>
            <p class="section-subtitle">@content.Experience.Subtitle</p>
        </div>

        <div class="experience-timeline">
            @foreach (var role in content.Experience.Roles)
            {
                var isChetu = role.Accent == "chetu";
                var dotClass = isChetu ? "timeline-dot chetu-dot" : "timeline-dot";
                var tagClass = isChetu ? "company-tag chetu-tag" : "company-tag";
                var dateClass = isChetu ? "date-pill chetu-date" : "date-pill";
                var iconClass = isChetu ? "responsibility-icon chetu-icon" : "responsibility-icon";
                <article class="experience-card reveal">

                    <div class="@dotClass"></div>

                    <div class="experience-header">
                        <div class="experience-company">
                            <span class="@tagClass">@role.Company</span>
                            <h3>@role.Title</h3>
                            <p class="experience-client">
                                <i class="bi @role.ClientIcon"></i>
                                @role.ClientLabel
                            </p>
                        </div>

                        <div class="@dateClass">
                            <i class="bi bi-calendar3"></i>
                            <span>@role.DateRange</span>
                        </div>
                    </div>

                    <div class="experience-environment">
                        <div class="environment-title">
                            <i class="bi bi-server"></i>
                            <span>Environment</span>
                        </div>
                        <div class="environment-tags">
                            @foreach (var tech in role.Environment)
                            {
                                <span>@tech</span>
                            }
                        </div>
                    </div>

                    <div class="responsibility-grid">
                        @foreach (var item in role.Responsibilities)
                        {
                            <div class="responsibility-item">
                                <div class="@iconClass">
                                    <i class="bi @item.Icon"></i>
                                </div>
                                <div>
                                    <h4>@item.Title</h4>
                                    <p>@item.Description</p>
                                </div>
                            </div>
                        }
                    </div>

                </article>
            }
        </div>

    </div>
</section>

<section id="expertise" class="section section-light">
    <div class="container">
        <div class="section-heading reveal">
            <span class="section-kicker">@content.Expertise.Kicker</span>
            <h2>@Html.Raw(content.Expertise.Heading)</h2>
            <p>@content.Expertise.Subtitle</p>
        </div>
        <div class="row g-3">
            @foreach (var skill in content.Expertise.Skills)
            {
                <div class="col-md-6 col-lg-4 reveal">
                    <div class="skill-card">
                        <div class="skill-icon"><i class="bi @skill.Icon"></i></div>
                        <h3>@skill.Title</h3>
                        <p>@skill.Description</p>
                        <div class="tags">
                            @foreach (var tag in skill.Tags)
                            {
                                <span>@tag</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="azure" class="section section-navy">
    <div class="container">
        <div class="section-heading light reveal">
            <span class="section-kicker">@content.DataPlatform.Kicker</span>
            <h2>@Html.Raw(content.DataPlatform.Heading)</h2>
        </div>
        <div class="data-flow reveal">
            @for (var i = 0; i < content.DataPlatform.Flow.Count; i++)
            {
                var node = content.DataPlatform.Flow[i];
                <div class="flow-node"><i class="bi @node.Icon"></i><b>@node.Title</b><small>@node.Subtitle</small></div>
                if (i < content.DataPlatform.Flow.Count - 1)
                {
                    <div class="flow-arrow"><i class="bi bi-arrow-right"></i></div>
                }
            }
        </div>
        <div class="row g-4 mt-2">
            @foreach (var card in content.DataPlatform.Cards)
            {
                <div class="col-lg-4 reveal">
                    <div class="dark-mini-card">
                        <span>@card.Number</span>
                        <h3>@card.Title</h3>
                        <p>@card.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="education" class="section section-light">
    <div class="container">
        <div class="section-heading reveal">
            <span class="section-kicker">@content.Education.Kicker</span>
            <h2>@Html.Raw(content.Education.Heading)</h2>
        </div>
        <div class="row g-4">
            @foreach (var item in content.Education.Items)
            {
                <div class="col-lg-6 reveal">
                    <div class="education-card">
                        <i class="bi @item.Icon"></i>
                        <div>
                            <span class="mini-label">@item.Label</span>
                            <h3>@item.Title</h3>
                            <p>@item.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="contact" class="contact-section">
    <div class="container">
        <div class="contact-card reveal">
            <div class="contact-copy">
                <span class="section-kicker">@content.Contact.Kicker</span>
                <h2>@Html.Raw(content.Contact.Heading)</h2>
                <p>@content.Contact.Subtitle</p>

                @if (TempData["Success"] is string successMessage)
                {
                    <div class="form-alert form-alert-success" role="status">
                        <i class="bi bi-check-circle"></i> @successMessage
                    </div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="form-alert form-alert-error" role="alert">
                        <i class="bi bi-exclamation-circle"></i> @errorMessage
                    </div>
                }

                <form class="contact-form" asp-controller="Home" asp-action="Contact" method="post">
                    <div class="form-field">
                        <label asp-for="ContactForm.Name">Name</label>
                        <input asp-for="ContactForm.Name" class="form-input" placeholder="Your name" autocomplete="name" required />
                        <span asp-validation-for="ContactForm.Name" class="form-error"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="ContactForm.Email">Email</label>
                        <input asp-for="ContactForm.Email" class="form-input" placeholder="you@example.com" autocomplete="email" required />
                        <span asp-validation-for="ContactForm.Email" class="form-error"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="ContactForm.Message">Message</label>
                        <textarea asp-for="ContactForm.Message" class="form-input form-textarea" rows="4" placeholder="Tell me about the opportunity or project..." required minlength="10"></textarea>
                        <span asp-validation-for="ContactForm.Message" class="form-error"></span>
                    </div>
                    <button type="submit" class="btn btn-primary-custom btn-lg form-submit">
                        <i class="bi bi-send"></i> Send Message
                    </button>
                </form>
            </div>

            <div class="contact-actions">
                <a class="contact-action whatsapp" href="@whatsappUrl" target="_blank" rel="noopener">
                    <i class="bi bi-whatsapp"></i><span><small>MESSAGE ON</small><b>WhatsApp</b></span><i class="bi bi-arrow-up-right"></i>
                </a>
                <a class="contact-action email" href="mailto:@person.Email">
                    <i class="bi bi-envelope"></i><span><small>EMAIL ME</small><b>@person.Email</b></span><i class="bi bi-arrow-up-right"></i>
                </a>
                <a class="contact-action phone" href="@telUrl">
                    <i class="bi bi-telephone"></i><span><small>CALL</small><b>@person.PhoneDisplay</b></span><i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </div>
    </div>
</section>
